meta {
  name: 5. Ver la simulación
  type: http
  seq: 5
}

get {
  url: {{base_url}}/simulaciones/{{simulacion_id}}
  body: none
  auth: none
}

headers {
  Cookie: sesion={{token_sim_ana}}
}

tests {
  test("responde 200", function () { expect(res.getStatus()).to.equal(200); });
  test("es la pedida", function () { expect(res.getBody().id).to.equal(bru.getVar("simulacion_id")); });
  test("trae los parámetros", function () { expect(res.getBody().parametros.carrier_freq).to.equal(3000); });
}
