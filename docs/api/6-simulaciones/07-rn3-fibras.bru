meta {
  name: 7. RN3: sin ninguna fibra
  type: http
  seq: 7
}

post {
  url: {{base_url}}/simulaciones
  body: json
  auth: none
}

headers {
  Cookie: sesion={{token_sim_ana}}
}

body:json {
  {
    "nH": 0,
    "nM": 0,
    "nL": 0
  }
}

tests {
  test("responde 400", function () { expect(res.getStatus()).to.equal(400); });
  test("código parametros_invalidos", function () { expect(res.getBody().detail.codigo).to.equal("parametros_invalidos"); });
}
