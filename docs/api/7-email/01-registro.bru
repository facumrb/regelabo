meta {
  name: 1. Registro (manda el mail de verificación)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email_mail}}",
    "password": "clave-larga-1",
    "nombre": "Usuario de Bruno",
    "tipo_perfil": "estudiante",
    "acepta_aviso": true
  }
}

script:pre-request {
  bru.setVar("email_mail", "bruno-mail-" + Date.now() + "@example.com");
}

tests {
  test("responde 201", function () { expect(res.getStatus()).to.equal(201); });
  test("sin verificar (RN15)", function () { expect(res.getBody().email_verificado).to.equal(false); });
}

docs {
  El mail con el enlace se escribe en la consola del backend si no hay `SMTP_HOST` en el `.env`.
}
