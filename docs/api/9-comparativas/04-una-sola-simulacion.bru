meta {
  name: 4. Con una sola simulación da 422
  type: http
  seq: 4
}

post {
  url: {{base_url}}/comparativas
  body: json
  auth: none
}

headers {
  Cookie: sesion={{token_comp}}
}

body:json {
  { "titulo": "Prueba", "simulacion_ids": ["0190a000-0000-7000-8000-000000000001"] }
}

tests {
  test("responde 422", function () { expect(res.getStatus()).to.equal(422); });
}
