meta {
  name: 2. Login (dueña)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email_ana}}",
    "password": "clave-larga-1"
  }
}

script:post-response {
  const cookies = [].concat(res.getHeader("set-cookie") || []);
  const sesion = cookies.find(function (c) { return String(c).startsWith("sesion="); });
  bru.setVar("token_ana", sesion ? String(sesion).split(";")[0].slice("sesion=".length) : "");
}

tests {
  test("responde 200", function () { expect(res.getStatus()).to.equal(200); });
  test("hay un token", function () { expect(bru.getVar("token_ana")).to.not.equal(""); });
}
