meta {
  name: Registro sin aceptar el aviso
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "email": "bruno-rechazado@example.com",
    "password": "clave-larga-1",
    "nombre": "Rechazado",
    "tipo_perfil": "estudiante",
    "acepta_aviso": false
  }
}

tests {
  test("400 Bad Request", function () { expect(res.getStatus()).to.equal(400); });
  test("código aviso_no_aceptado", function () { expect(res.getBody().detail.codigo).to.equal("aviso_no_aceptado"); });
  test("trae un mensaje en español", function () { expect(res.getBody().detail.mensaje).to.be.a("string").that.is.not.empty; });
}

docs {
  RN9: el aviso de uso no profesional es obligatorio.
}
