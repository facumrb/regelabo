meta {
  name: 5. Nueva igual a la actual
  type: http
  seq: 5
}

post {
  url: {{base_url}}/auth/contrasena
  body: json
  auth: none
}

headers {
  Cookie: sesion={{token_cuenta}}
}

body:json {
  {
    "actual": "clave-vieja-1",
    "nueva": "clave-vieja-1"
  }
}

tests {
  test("responde 400", function () { expect(res.getStatus()).to.equal(400); });
  test("código contrasena_repetida", function () { expect(res.getBody().detail.codigo).to.equal("contrasena_repetida"); });
}
