# Copiar a .env (no se sube al repo) y ajustar si hace falta.
# Base local levantada con `docker compose up -d db`
DATABASE_URL=postgresql+psycopg://regelabo:regelabo@localhost:5432/regelabo

# Desarrollo usa http, así que la cookie de sesión no puede ser "Secure". En producción dejarlo en true.
COOKIE_SECURE=false
# Opcionales (valores por defecto): SESION_HORAS=12, INTENTOS_MAX=10, BLOQUEO_MINUTOS=15,
# TOPE_COLA=20, SIMULACION_MINUTOS_MAX=5

# Mails de verificación y recuperación (decisión 030). Sin SMTP_HOST el mail se escribe en la
# consola del backend, con el enlace adentro. Con Gmail: contraseña de aplicación de la cuenta del
# proyecto (Cuenta de Google → Seguridad → Contraseñas de aplicaciones), nunca la contraseña normal.
URL_PUBLICA=http://localhost:5173
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USUARIO=correo-del-proyecto@gmail.com
# SMTP_CONTRASENA=
