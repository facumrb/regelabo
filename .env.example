# Copiar a .env (no se sube al repo) y ajustar si hace falta.
# Base local levantada con `docker compose up -d db`
DATABASE_URL=postgresql+psycopg://regelabo:regelabo@localhost:5432/regelabo

# Desarrollo usa http, así que la cookie de sesión no puede ser "Secure". En producción dejarlo en true.
COOKIE_SECURE=false
# Opcionales (valores por defecto): SESION_HORAS=12, INTENTOS_MAX=10, BLOQUEO_MINUTOS=15
